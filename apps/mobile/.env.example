# Public configuration bundled into the app (EXPO_PUBLIC_*); nothing secret.
# EAS builds take these from the profile env in eas.json plus EAS environment
# variables (the DSN); point a local dev build at staging by setting the API
# URL to https://curb-api-staging.onrender.com here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Build-time only: the reversed iOS client id used as the Google Sign-In URL
# scheme (com.googleusercontent.apps.<id>). Unset skips the plugin.
GOOGLE_IOS_URL_SCHEME=

# Build-time only (EAS secret): lets Sentry's config plugin upload source
# maps and dSYMs. Unset skips the plugin; events still report. The native
# project therefore differs between a local prebuild and an EAS build.
SENTRY_AUTH_TOKEN=
