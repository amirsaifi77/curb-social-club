# Public, build-time configuration (VITE_*): inlined into client and server
# bundles by Vite. Nothing secret lives here.
VITE_API_URL=http://localhost:3000
VITE_SENTRY_DSN=

# Server only. SENTRY_ENVIRONMENT defaults to VERCEL_ENV (production, preview).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Set to 1 on a deployment to make GET /sentry-test throw a test error; unset after.
SENTRY_TEST_ENABLED=
