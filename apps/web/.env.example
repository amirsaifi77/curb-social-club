# Public, build-time configuration (VITE_*): inlined into client and server
# bundles by Vite. Nothing secret lives here.
VITE_API_URL=http://localhost:3000
VITE_SENTRY_DSN=

# Server only. SENTRY_ENVIRONMENT defaults to VERCEL_ENV (production, preview).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Set to 1 on a deployment to make GET /sentry-test throw a test error; unset after.
SENTRY_TEST_ENABLED=

# web.md R-23: read at runtime, no defaults committed. The domain is
# unconfirmed (gaps item 2), so a missing SHARE_BASE_URL omits canonical and
# OG links rather than pointing them somewhere wrong.
API_URL=http://localhost:3000
SHARE_BASE_URL=

# Unknown until App Store Connect reserves the app. The smart banner and the
# App Store fallback links render only when this is set.
APP_STORE_ID=

# The Apple team id the AASA names (R-18); 1.17 serves the file.
TEAM_ID=
