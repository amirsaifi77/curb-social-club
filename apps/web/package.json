{
  "name": "@curb/web",
  "version": "0.0.0",
  "private": true,
  "description": "Curb Social Club public web app: React Router v7 framework mode, SSR on Vercel.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf build .react-router .vercel .turbo"
  },
  "dependencies": {
    "@curb/design-tokens": "workspace:*",
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "@sentry/react-router": "^10.73.0",
    "isbot": "^5.1.31",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@curb/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^7.18.3",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vercel/react-router": "^1.3.6",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
