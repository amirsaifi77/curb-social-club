{
  "extends": "@curb/config/tsconfig.react.json",
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "exclude": ["node_modules", "build", ".vercel"],
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "module": "ES2022",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@curb/*": ["../../packages/*/src/index.ts"]
    },
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
