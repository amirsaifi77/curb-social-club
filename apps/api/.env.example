# Copy to .env for local development (dotenv loads it in development and test).
# Every variable from docs/local-development.md; unset values fall back to safe
# defaults or disable the feature they configure.

# Postgres. Use the postgis:// scheme so the PostGIS adapter is selected;
# a postgres:// URL would switch Active Record back to the plain adapter.
DATABASE_URL=postgis://curb:curb@localhost:5432/curb_social_club_development

# Not used; credentials stay unset (docs/local-development.md).
# RAILS_MASTER_KEY=

# Active Record encryption for identities.provider_refresh_token. Required in
# production; development and test fall back to fixed non-secret keys.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Sign in with Apple verification and token revocation (session 0.5).
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Google id token audiences (session 0.5); the admin id arrives with 0.7.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ADMIN_CLIENT_ID=

# Active Storage on Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=

# Expo push notifications.
EXPO_ACCESS_TOKEN=

# Transactional email through Resend.
RESEND_API_KEY=

# Error tracking; leave unset to disable Sentry locally.
SENTRY_DSN=

# Importer LLM fallback (docs/importer.md).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Eventbrite adapter (the only official import API).
EVENTBRITE_TOKEN=

# Geocoding.
GEOCODER_APPLE_KEY=
GEOCODER_GOOGLE_KEY=

# CORS origin of the deployed web app, e.g. https://curbsocial.club.
WEB_ORIGIN=
