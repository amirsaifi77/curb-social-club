source "https://rubygems.org"

# Core
gem "rails", "~> 8.1.3", ">= 8.1.3.1"
# json 3.x removed JSON.parse options that json-schema (via rswag response
# validation) still passes; pin to 2.x until json-schema supports json 3.
gem "json", "~> 2.9"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"
gem "bootsnap", require: false
gem "thruster", require: false
gem "tzinfo-data", platforms: %i[ windows jruby ]
gem "kamal", require: false

# API
gem "rack-cors"
gem "alba"
gem "pagy"
gem "pundit"
gem "rack-attack"

# Geo (activerecord-postgis-adapter 11.x supports Active Record 8.1, ADR 0003)
gem "activerecord-postgis-adapter", "~> 11.1"
gem "rgeo"
gem "rgeo-geojson"
gem "geocoder"

# Recurrence expansion for MaterializeOccurrencesJob (docs/architecture.md 3.5)
gem "ice_cube"

# Jobs and cache (both on the primary database, docs/data-model.md).
# mission_control-jobs mounts at /admin/jobs behind the admin session
# (docs/specs/admin.md R-12); it needs an asset pipeline, so propshaft
# serves its assets plus admin.css and admin.js (R-6).
gem "solid_queue"
gem "solid_cache"
gem "mission_control-jobs"
gem "propshaft"

# Media (from rails new; the rest of the media group arrives with uploads)
gem "image_processing", "~> 1.2"

# Auth (Apple and Google id token verification, Apple client secret)
gem "jwt"

# Docs (rswag-specs is test-only below; rswag-ui is development-only)
gem "rswag-api"

# Observability
gem "sentry-ruby"
gem "sentry-rails"
gem "lograge"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
  gem "rubocop-rspec", require: false
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "faker"
  gem "dotenv-rails"
  gem "rswag-specs"
end

group :development do
  gem "rswag-ui"
  gem "annotaterb"
  gem "bullet"
  gem "letter_opener"
end

group :test do
  gem "shoulda-matchers"
  gem "webmock"
  gem "vcr"
  # Matchers for the admin's rendered HTML (docs/specs/admin.md Verification).
  # No driver and no system tests: request specs assert on response.body.
  gem "capybara"
end
