<% content_for :title, "Applied" %>
<h1>Applied: <%= @kind %></h1>

<% if @problem %>
  <p class="form-errors" role="alert"><%= @problem %></p>
<% else %>
  <% counts = @report.counts %>
  <p><%= "Applied. #{counts[:create]} created, #{counts[:update]} updated, #{counts[:skip]} unchanged." %></p>
  <%= render "report_table", report: @report %>
<% end %>

<p><%= link_to "Import another file", admin_seeds_path %></p>
