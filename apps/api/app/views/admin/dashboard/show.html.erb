<% content_for :title, "Dashboard" %>
<h1>Dashboard</h1>

<section>
  <h2>Counts</h2>
  <table class="detail">
    <tbody>
      <% @counts.each do |label, count| %>
        <tr><th scope="row"><%= label %></th><td class="num"><%= count %></td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<section>
  <h2>Seed decay</h2>
  <% if @decay[:stale].zero? && @decay[:dormant].zero? %>
    <p class="muted">Nothing has gone stale.</p>
  <% else %>
    <p>
      <%= link_to "#{pluralize(@decay[:stale], 'unclaimed meet')} not confirmed in 30 days",
                  admin_events_path(stale: 1, claimed: "no") %>.
      <%= pluralize(@decay[:dormant], 'hidden') %> after 90.
    </p>
  <% end %>
</section>

<section>
  <h2>Jobs</h2>
  <% if @jobs.failed.positive? %>
    <p class="flash flash-alert"><%= pluralize(@jobs.failed, "failed job") %>. <%= link_to "Open Jobs", mission_control_jobs.root_path if current_admin.admin? %></p>
  <% end %>
  <table class="detail">
    <tbody>
      <tr><th scope="row">Failed</th><td class="num"><%= @jobs.failed %></td></tr>
      <tr><th scope="row">Ready</th><td class="num"><%= @jobs.ready %></td></tr>
      <tr><th scope="row">Scheduled</th><td class="num"><%= @jobs.scheduled %></td></tr>
      <tr><th scope="row">In progress</th><td class="num"><%= @jobs.in_progress %></td></tr>
    </tbody>
  </table>

  <h3>Recurring tasks</h3>
  <%= render "admin/shared/table",
             columns: [ "Task", "Schedule", "Last run", "Status" ],
             empty: "Nothing here yet. The scheduler loads config/recurring.yml when it starts.",
             rows: @jobs.tasks.map { |task| [
               "#{task.key} #{tag.span(task.class_name, class: 'muted')}".html_safe,
               task.schedule,
               task.last_run_at ? admin_time(task.last_run_at) : "No run yet",
               task.last_status || "No run yet"
             ] } %>
  <% if current_admin.admin? %>
    <p><%= link_to "Open Jobs", mission_control_jobs.root_path %></p>
  <% end %>
</section>

<section>
  <h2>Host consistency</h2>
  <% if @report.nil? %>
    <p class="muted">No run yet.</p>
  <% else %>
    <p class="muted">Last run <%= admin_time(Time.iso8601(@report[:generated_at])) %>.</p>
    <table class="detail">
      <tbody>
        <tr><th scope="row">Missing hosts</th><td class="num"><%= @report[:missing].size %></td></tr>
        <tr><th scope="row">Hidden hosts</th><td class="num"><%= @report[:hidden].size %></td></tr>
        <tr><th scope="row">Names rewritten</th><td class="num"><%= @report[:renamed].size %></td></tr>
      </tbody>
    </table>
    <% rows = @report[:missing] + @report[:hidden] %>
    <% if rows.any? %>
      <%= render "admin/shared/table",
                 columns: [ "Event", "Host type", "Host" ],
                 rows: rows.map { |row| [ row[:slug], row[:host_type], row[:name] || row[:host_id] ] } %>
    <% end %>
  <% end %>
</section>
