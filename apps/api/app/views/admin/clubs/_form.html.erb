<%= form_with model: [ :admin, club ], class: "record-form" do |form| %>
  <%= render "admin/shared/form_errors", record: club %>

  <%= render "admin/shared/field", form: form, name: :name %>
  <%= render "admin/shared/field", form: form, name: :slug,
             hint: "3 to 40 lowercase letters, digits, or hyphens. Generated from the name when blank." %>
  <%= render "admin/shared/field", form: form, name: :description, control: form.text_area(:description, rows: 5) %>
  <%= render "admin/shared/field", form: form, name: :home_label, hint: "Where the club is based, in words." %>
  <%= render "admin/shared/field", form: form, name: :home_lat, label: "Home latitude",
             control: form.number_field(:home_lat, step: "any", value: club.home_location&.y) %>
  <%= render "admin/shared/field", form: form, name: :home_lng, label: "Home longitude",
             control: form.number_field(:home_lng, step: "any", value: club.home_location&.x) %>
  <%= render "admin/shared/links_fields", record: club, scope: "club" %>
  <%= render "admin/shared/field", form: form, name: :join_policy, control: form.select(:join_policy, Club::JOIN_POLICIES) %>
  <%= render "admin/shared/field", form: form, name: :status, control: form.select(:status, Club::STATUSES) %>
  <div class="field"><label><%= form.check_box :verified %> Verified</label></div>
  <%= render "admin/shared/field", form: form, name: :avatar, control: form.file_field(:avatar, accept: "image/*") %>
  <%= render "admin/shared/field", form: form, name: :banner, control: form.file_field(:banner, accept: "image/*") %>

  <% if club.new_record? %>
    <div class="field">
      <%= label_tag :owner_handle, "Owner handle" %>
      <%= text_field_tag :owner_handle, params[:owner_handle], placeholder: "curb" %>
      <p class="hint">A club has exactly one owner. Blank means the app account.</p>
    </div>
  <% end %>

  <div class="actions">
    <%= form.submit club.new_record? ? "Create club" : "Save club" %>
    <%= link_to "Cancel", club.new_record? ? admin_clubs_path : admin_club_path(club) %>
  </div>
<% end %>
