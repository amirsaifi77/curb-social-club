{
  "name": "@curb/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/tokens.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.theme": "./dist/tailwind.theme.js",
    "./tokens.json": "./tokens.json",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "tsx build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "fonts": "python3 scripts/subset_fonts.py"
  },
  "devDependencies": {
    "@curb/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
