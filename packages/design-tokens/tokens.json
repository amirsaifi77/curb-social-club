{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "TODO (brand workstream): replace every placeholder value below with the Cars and Coffee brand system. Keep the structure; add groups as needed. Semantic tokens reference raw tokens with {path} syntax. Dark overrides go under $extensions.cac.dark.",
  "color": {
    "raw": {
      "black": { "$type": "color", "$value": "#000000", "$description": "TODO placeholder" },
      "white": { "$type": "color", "$value": "#FFFFFF", "$description": "TODO placeholder" },
      "brand-500": { "$type": "color", "$value": "#FF6A00", "$description": "TODO placeholder primary" },
      "neutral-100": { "$type": "color", "$value": "#F5F5F5", "$description": "TODO placeholder" },
      "neutral-900": { "$type": "color", "$value": "#111111", "$description": "TODO placeholder" }
    },
    "semantic": {
      "background": {
        "$type": "color",
        "$value": "{color.raw.white}",
        "$extensions": { "cac": { "dark": "{color.raw.neutral-900}" } }
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.raw.neutral-900}",
        "$extensions": { "cac": { "dark": "{color.raw.neutral-100}" } }
      },
      "accent": { "$type": "color", "$value": "{color.raw.brand-500}" }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "22px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "typography": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["TODO", "system-ui"] },
      "body": { "$type": "fontFamily", "$value": ["TODO", "system-ui"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "28px" }
    }
  },
  "glass": {
    "$description": "iOS 26 Liquid Glass parameters, also used by web to echo the material.",
    "blur": { "$type": "dimension", "$value": "20px" },
    "tint-alpha": { "$type": "number", "$value": 0.6 },
    "border-alpha": { "$type": "number", "$value": 0.18 }
  }
}
